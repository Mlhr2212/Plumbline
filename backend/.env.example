# Copy to .env for local development. Never commit real values.

PLUMBLINE_ENVIRONMENT=dev
PLUMBLINE_STORAGE_BACKEND=memory        # memory | sqlite | dynamodb
PLUMBLINE_SQLITE_PATH=plumbline.db      # only used when storage_backend=sqlite
PLUMBLINE_AWS_REGION=us-east-1

# Required when storage_backend=dynamodb
PLUMBLINE_DDB_TABLE_DRIFTS=plumbline-drifts
PLUMBLINE_DDB_TABLE_SCANS=plumbline-scans
PLUMBLINE_DDB_TABLE_TIMELINE=plumbline-timeline
PLUMBLINE_DDB_TABLE_RECONCILIATIONS=plumbline-reconciliations

# CI ingestion HMAC secret (required for the signed ingest path)
PLUMBLINE_INGEST_HMAC_SECRET=

# Mutation endpoint API key (required in deployed environments)
PLUMBLINE_API_KEY=

# Attribution
PLUMBLINE_ATTRIBUTION_ENABLED=true
PLUMBLINE_ATTRIBUTION_LOOKBACK_HOURS=72

# Auto-remediation — keep disabled until detection is proven
PLUMBLINE_AUTO_REMEDIATION_ENABLED=false
PLUMBLINE_AUTO_REMEDIATION_ALLOW_PRODUCTION=false

# GitHub reconciliation PRs
PLUMBLINE_GITHUB_TOKEN=
PLUMBLINE_GITHUB_REPOSITORY=
PLUMBLINE_GITHUB_BASE_BRANCH=main

# IaC engine: terraform | tofu (OpenTofu path is untested)
PLUMBLINE_IAC_ENGINE=terraform
